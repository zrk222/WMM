  "findings": [
    {
      "id": "dynamic-inspector",
      "source": "packages/studio-companion/src/index.ts",
      "finding": "Compiled item and track-object fields carry schemas, grouping and separate edit authority. Preserve all selected Companion fields, including list/record structures; do not hard-code caption controls."
    },
    {
      "id": "typed-mutations",
      "source": "packages/studio/src/shared.ts",
      "finding": "StudioMutation has timeline.adjust and parameter.adjust variants. Bind revision, owner/item and declared field or enabled gesture; do not expose arbitrary HTTP requests or caller source patches."
    },
    {
      "id": "source-transactions",
      "source": "packages/studio/src/server.ts",
      "finding": "Source writes use allowedSourceFiles, relative paths and current preimages. Parameter edits validate schema/options and source transactions recompile. WMM must preserve these checks and add app ownership/source history."
    },
    {
      "id": "preview-execution",
      "source": "packages/studio/src/build-library.ts",
      "finding": "openControl is readOnly, but openTransientExecution is a separate host. Local-only preflight and component admission must cover preview as well as durable builds. No paid activity was observed or attempted in this review."
    },
    {
      "id": "origin-not-identity",
      "source": "packages/studio/src/mutation-origin.ts",
      "finding": "Upstream validates localhost Host, same origin when present, and fetch site. This does not establish WMM app identity, grant scope, standing approval or revocation."
    },
    {
      "id": "feedback-parity",
      "source": "packages/studio/src/feedback-server.ts",
      "finding": "Run-scoped feedback uses persisted optimistic mutations and change notifications. WMM must expose revision changes to admitted agents; upstream comments alone are not agent task delivery."
    },
    {
      "id": "results-reuse",
      "source": "packages/studio/src/build-library.ts",
      "finding": "Library resolves stable Build/Output identities, ongoing activity, historical outputs and presentation names. Viewing or renaming an artifact must not imply accepted reuse or publication approval."
    },
    {
      "id": "owned-lifecycle",
      "source": "packages/studio/src/start.ts",
      "finding": "Studio accepts Run, project, runtime, package root and port arguments, opens a Vite server and closes the library on HTTP shutdown. WMM must own these values, loopback binding, process lifecycle and preview isolation."
    }
  ],
  "next_step": "Implement and prove owned session broker, installed ABI/profile identity and admitted transient preview; then full compiled controls and typed transactions. Retain every parent workflow requirement."
}
